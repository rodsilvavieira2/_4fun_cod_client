# Unified diff context uses a single-space prefix, including blank lines.
packages/flutter_webrtc/third_party/patches/*.patch whitespace=-blank-at-eol
# Hash-pinned by third_party/CMakeLists.txt (patch_sha256): must be
# byte-identical on every checkout — autocrlf (Windows default true)
# rewrites LF->CRLF and breaks the pin with a configure-time FATAL.
packages/flutter_webrtc/third_party/patches/*.patch text eol=lf
